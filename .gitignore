# Virtual Environment
venv/
.venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Logs
logs/
*.log

# Large temporary files
*.tmp

# Installers & binaries (should never be committed)
*.exe
*.msi
*.winmd
*.pkl

# Heavy Datasets & Artifacts
**/Data/Raw/*.csv
**/Data/Processed/raw_merged.csv
**/Artifacts/*.pkl
